{% block task_context %}
<task_context>
Generate a single high-quality image for advertising.
- Prioritize the <image_description> if provided
- If an origin image is provided, generate a variant of the origin image based on the <image_description>
- Only overlay text if specifically requested in <image_description>
</task_context>

<image_description>
{{ description }}
</image_description>

<campaign_context>
{{ name }}
{{ summary }}
</campaign_context>
{% endblock %}
