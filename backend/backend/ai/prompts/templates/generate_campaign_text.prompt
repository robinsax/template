{% extends "base.prompt" %}

{% block task_context %}
<task_context>
{% if original_text %}
Generate a new variant of the original ad copy.
{% else %}
Generate text ad copy.
{% endif %}

<campaign_name>
{{ name }}
</campaign_name>
<campaign_summary>
{{ summary }}
</campaign_summary>
</task_context>

<critical_behavior_rules>
- DO NOT ask for clarification.
- ALWAYS generate EXACTLY ONE piece of copy.
- STRICTLY ADHERE to the character length constraints in copy_specifications.
- Your output MUST be between the min_length and max_length specified (character count, including spaces).
- DO NOT include any formatting, markdown, quotes, or extra characters in your output.
- Output ONLY the copy text itself.
- Prioritize adhering to the copy_prompt if provided.
- If original_text is provided: rewrite, reframe, condense, or creatively reinterpret it.
</critical_behavior_rules>

{% if original_text %}
<original_text>
{{ original_text }}
</original_text>
{% endif %}

{% if description %}
<copy_prompt>
{{ description }}
</copy_prompt>
{% endif %}

<copy_specifications>
{{ text_specs }}

CRITICAL: The "min_length" and "max_length" fields specify the EXACT character count range (including spaces and punctuation) that your generated text MUST fall within. Count every character.
</copy_specifications>
{% endblock %}
